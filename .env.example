# Copy to .env for local development. Never commit .env.

# Postgres 16+. Local: `docker compose up -d` gives you this URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bmnt
# For `pnpm test` integration tests; this database is wiped on every run.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/bmnt_test
# Set to "false" when DATABASE_URL points at a transaction pooler (e.g. Neon's -pooler host).
# DATABASE_PREPARE=false

# YouTube Data API v3 key (Google Cloud Console). Restrict it to the YouTube Data API.
YOUTUBE_API_KEY=

# Long random string; signs you in at /admin to review video links.
ADMIN_TOKEN=

# Override only if BWF moves its API.
# BWF_API_BASE=https://extranet-lv.bwfbadminton.com/api
